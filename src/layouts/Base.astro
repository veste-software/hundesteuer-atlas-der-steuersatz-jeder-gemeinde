---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { absoluteUrl, withBase } from '../lib/url';

interface Props {
  /** Unique page title, without the site name. */
  title: string;
  /** Unique meta description. */
  description: string;
  /** Site-internal path of this page, e.g. "/nrw/". Used for the canonical URL. */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = absoluteUrl(path, site, import.meta.env.BASE_URL);
const fullTitle = path === '/' ? title : `${title} · Hundesteuer-Atlas`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#e4e9df" />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <div class="page">
      <header class="masthead">
        <a class="wordmark" href={withBase('/')}>Hundesteuer-Atlas</a>
        <nav class="label" aria-label="Hauptnavigation">
          <a href={withBase('/nrw/')}>NRW</a>
          <a href={withBase('/methodik/')}>Methodik</a>
        </nav>
      </header>

      <main id="inhalt">
        <slot />
      </main>

      <footer class="colophon">
        <nav aria-label="Rechtliches">
          <a href={withBase('/impressum/')}>Impressum</a>
          <a href={withBase('/datenschutz/')}>Datenschutz</a>
          <a href={withBase('/methodik/')}>Methodik</a>
        </nav>
        <p>Angaben ohne Gewähr. Verbindlich ist allein die Satzung der Gemeinde.</p>
        <p class="caption">Gemeindeliste: Wikidata (CC0). Steuersätze: Hundesteuersatzungen der Gemeinden, jeweils mit Link und Abrufdatum.</p>
      </footer>
    </div>
  </body>
</html>
