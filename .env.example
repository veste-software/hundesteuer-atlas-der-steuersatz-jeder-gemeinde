# Names only. Never commit values. Copy to .env for local use.

# Build: canonical URLs, sitemap and base path. The Pages workflow sets these for previews.
SITE_URL=
SITE_BASE=

# Affiliate link for the "Anzeige" box on municipality pages (Hundehaftpflicht). Unset = neutral box, no link.
AFFILIATE_HAFTPFLICHT_URL=

# Contact address for "Fehler melden" mailto links (same as the Impressum address).
PUBLIC_CONTACT_EMAIL=

# Cookie-free analytics (Plausible-compatible). Both must be set; the script path must be first-party (starts with "/").
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=

# Harvest pipeline (optional). Without it the pipeline uses sitemaps and crawling only.
BRAVE_SEARCH_API_KEY=
